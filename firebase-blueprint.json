{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Peça de lingerie ou vestuário íntimo do catálogo",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Identificador único do produto" },
        "name": { "type": "string", "description": "Nome do produto" },
        "slug": { "type": "string", "description": "Slug para URL amigável" },
        "sku": { "type": "string", "description": "Código SKU do produto" },
        "category": { "type": "string", "description": "Categoria do produto" },
        "price": { "type": "number", "description": "Preço normal em R$" },
        "salePrice": { "type": "number", "description": "Preço promocional em R$" },
        "stock": { "type": "number", "description": "Quantidade em estoque" },
        "minStock": { "type": "number", "description": "Alerta de estoque mínimo" },
        "images": { "type": "array", "description": "URLs das imagens" },
        "description": { "type": "string", "description": "Descrição detalhada" },
        "sizes": { "type": "array", "description": "Tamanhos disponíveis" },
        "colors": { "type": "array", "description": "Cores disponíveis" },
        "isFeatured": { "type": "boolean", "description": "Destaque" },
        "isNew": { "type": "boolean", "description": "Lançamento" },
        "isSale": { "type": "boolean", "description": "Em oferta" },
        "rating": { "type": "number", "description": "Média de avaliação" },
        "reviewCount": { "type": "number", "description": "Total de avaliações" }
      },
      "required": ["id", "name", "category", "price", "stock", "images"]
    },
    "Order": {
      "title": "Order",
      "description": "Pedido de compra realizado na loja",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID do pedido" },
        "customerName": { "type": "string", "description": "Nome do cliente" },
        "customerEmail": { "type": "string", "description": "E-mail do cliente" },
        "customerPhone": { "type": "string", "description": "Telefone do cliente" },
        "items": { "type": "array", "description": "Itens do pedido" },
        "subtotal": { "type": "number", "description": "Subtotal em R$" },
        "shippingCost": { "type": "number", "description": "Frete em R$" },
        "discount": { "type": "number", "description": "Desconto em R$" },
        "total": { "type": "number", "description": "Total do pedido em R$" },
        "shippingAddress": { "type": "object", "description": "Endereço de entrega" },
        "status": { "type": "string", "description": "Status do pedido" },
        "paymentMethod": { "type": "string", "description": "Forma de pagamento" },
        "createdAt": { "type": "string", "description": "Data e hora do pedido" }
      },
      "required": ["id", "customerName", "customerPhone", "items", "total", "status"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Cupom de desconto promocional",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID do cupom" },
        "code": { "type": "string", "description": "Código do cupom" },
        "discountPercent": { "type": "number", "description": "Porcentagem de desconto" },
        "active": { "type": "boolean", "description": "Se está ativo" }
      },
      "required": ["id", "code", "discountPercent", "active"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Configurações gerais da loja Moda Intima Todo Dia",
      "type": "object",
      "properties": {
        "storeName": { "type": "string", "description": "Nome da loja" },
        "tagline": { "type": "string", "description": "Slogan" },
        "whatsappNumber": { "type": "string", "description": "WhatsApp de vendas" },
        "whatsappMessage": { "type": "string", "description": "Mensagem padrão" },
        "email": { "type": "string", "description": "E-mail de contato" },
        "phone": { "type": "string", "description": "Telefone fixo" },
        "instagram": { "type": "string", "description": "Instagram" },
        "address": { "type": "string", "description": "Endereço físico" },
        "businessHours": { "type": "string", "description": "Horário de atendimento" },
        "freeShippingThreshold": { "type": "number", "description": "Frete grátis a partir de R$" },
        "announcementBarText": { "type": "string", "description": "Texto da barra de aviso" }
      },
      "required": ["storeName", "whatsappNumber"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Coleção de produtos do catálogo da loja"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Coleção de pedidos de clientes"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Cupons de desconto gerenciados no painel"
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Configurações da loja"
    }
  }
}
